# wa-service: salin ke .env (chmod 600, pemilik = user layanan). Nilai rahasia JANGAN dicetak.

# Alamat listen. Bawaan 127.0.0.1:3901 (satu mesin dengan aplikasi).
# VM terpisah: IP WireGuard wa-service, mis. HOST=10.250.0.2 (WA_ALLOWED_IPS WAJIB diisi).
HOST=127.0.0.1
PORT=3901

# IP/CIDR yang boleh memanggil API (dipisah koma). Bawaan loopback saja.
WA_ALLOWED_IPS=127.0.0.1,::1

# Bearer token aplikasi -> wa-service (sama dengan WA_SERVICE_TOKEN di .env aplikasi).
WA_SERVICE_TOKEN=

# Callback wa-service -> aplikasi (event status sesi, ack pesan, lease).
# Satu mesin: https://127.0.0.1/internal/wa-service/events + WA_CALLBACK_HOST=<domain aplikasi>.
# VM terpisah: https://<IP WireGuard aplikasi>/internal/wa-service/events + WA_CALLBACK_HOST.
WA_CALLBACK_URL=
WA_CALLBACK_HOST=
# Minimal 32 karakter, BERBEDA dari WA_SERVICE_TOKEN; sama dengan WA_CALLBACK_SECRET aplikasi.
WA_CALLBACK_SECRET=
# Jaringan privat tempat http tanpa TLS diizinkan (mis. subnet WireGuard 10.250.0.0/30).
WA_PRIVATE_NETWORKS=

# Kunci sesi lama (tenant 1): nama folder sessions/<kunci>, sama dengan .env aplikasi.
# Rute lama /status /connect /logout /send dipetakan ke sesi ini.
WA_LEGACY_SESSION_KEY=

# app = lease sesi dari aplikasi (pengaman dua wa-service); local = tanpa lease
# (HANYA selama aplikasi belum punya endpoint lease, deploy tahap 1).
WA_SESSION_LEASE=app

MAX_SESSIONS=6
SESSIONS_DIR=sessions
STATE_DIR=state
LOG_DIR=/var/log/wa-service
# Nama node di event/lease (bawaan: hostname).
NODE_NAME=
LOG_LEVEL=info
